<Window x:Class="DmC.Qa.Admin.BuildCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Sürümü Merkezi" Height="820" Width="1120" MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="TEST SÜRÜMLERİ" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Developer yükler; yönetici Güncel Test Sürümü yapar veya arşivler." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                </StackPanel>
                <DataGrid x:Name="BuildsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="#111318" Foreground="White" SelectionChanged="BuildsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" Width="100"/>
                        <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="140"/>
                        <DataGridTextColumn Header="Yükleyen" Binding="{Binding UploadedBy}" Width="120"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock x:Name="SelectedBuildInfo" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="PublishButton" Content="Güncel Test Sürümü Yap" Click="PublishButton_Click"/>
                        <Button x:Name="ArchiveButton" Content="Arşivle" Click="ArchiveButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="YENİ TEST SÜRÜMÜ YÜKLE" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Sürüm" Margin="0,14,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="VersionInput" Height="34"/>
                    <TextBlock Text="Başlık" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="TitleInput" Height="34"/>
                    <TextBlock Text="Açıklama" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="DescriptionInput" Height="75" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Değişiklik Notları" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="ChangelogInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Kurulum Talimatları" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="InstallInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Dosya" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FileInput" Height="34" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Dosya Seç" Margin="8,0,0,0" Click="ChooseFile_Click"/>
                    </Grid>
                    <ProgressBar x:Name="UploadProgress" Height="16" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                    <TextBlock x:Name="UploadStatus" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    <Button x:Name="UploadButton" Content="Test Sürümünü Oluştur ve Yükle" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Margin="0,12,0,0" Click="UploadButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
