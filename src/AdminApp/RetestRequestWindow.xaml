<Window x:Class="DmC.Qa.Admin.RetestRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeniden Test İste" Height="690" Width="720" MinHeight="620" MinWidth="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="YENİDEN TEST TALEBİ" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="BugText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Test Edilecek Sürüm" FontWeight="SemiBold"/>
                <ComboBox x:Name="BuildPicker" Height="36" Margin="0,6,0,14" DisplayMemberPath="Version"/>
                <TextBlock Text="Atanacak Test Ekibi Üyeleri" FontWeight="SemiBold"/>
                <ListBox x:Name="MembersList" Height="220" Margin="0,6,0,14" Background="{StaticResource CardBrush}" Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected}" Foreground="White" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="  •  "/>
                                    <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Son Tarih" FontWeight="SemiBold"/>
                <DatePicker x:Name="DeadlinePicker" Height="34" Margin="0,6,0,14"/>
                <TextBlock Text="Yönetici Notu / Kontrol Edilecek Nokta" FontWeight="SemiBold"/>
                <TextBox x:Name="NoteInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Click="Cancel_Click"/>
            <Button x:Name="SubmitButton" Content="Yeniden Test Oluştur" Background="{StaticResource AccentBrush}" Foreground="White" Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
