<Window x:Class="DmC.Qa.Admin.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proje Ayarları" Height="760" Width="980" MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <TabControl Margin="18" Background="Transparent">
        <TabItem Header="Mevcut Proje">
            <Grid Margin="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="CurrentProjectText" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="PROJE ÜYELERİ" FontWeight="Bold" Margin="0,16,0,8"/>
                        <ListBox x:Name="UsersList" Height="430" Background="#111318" Foreground="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" Foreground="White" Padding="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="  •  "/><TextBlock Text="{Binding Role}" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="SaveMembersButton" Content="Proje Üyelerini Kaydet" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,10,0,0" Click="SaveMembersButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16">
                    <StackPanel>
                        <TextBlock Text="BÖLÜMLER" FontWeight="Bold"/>
                        <ListBox x:Name="SectionsList" Height="390" Margin="0,8,0,12" DisplayMemberPath="Name" Background="#111318" Foreground="White"/>
                        <TextBlock Text="Yeni Bölüm / Mission / Chapter" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SectionNameInput" Height="34" Margin="0,5,0,8"/>
                        <Button Content="Bölüm Ekle" HorizontalAlignment="Left" Click="AddSectionButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Yeni Proje">
            <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="YENİ OYUN / QA PROJESİ" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="Aynı platformda aynı anda birden fazla proje çalışabilir." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                <TextBlock Text="Proje Adı"/>
                <TextBox x:Name="NewProjectNameInput" Height="36" Margin="0,5,0,10"/>
                <TextBlock Text="Proje Anahtarı (küçük harf, tire)"/>
                <TextBox x:Name="NewProjectKeyInput" Height="36" Margin="0,5,0,10"/>
                <TextBlock Text="Bölüm Adlandırması"/>
                <ComboBox x:Name="SectionLabelPicker" Height="36" Margin="0,5,0,16" SelectedIndex="0">
                    <ComboBoxItem Content="Mission"/><ComboBoxItem Content="Chapter"/><ComboBoxItem Content="Level"/><ComboBoxItem Content="Episode"/><ComboBoxItem Content="Bölüm"/>
                </ComboBox>
                <Button x:Name="CreateProjectButton" Content="Projeyi Oluştur" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" Click="CreateProjectButton_Click"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
