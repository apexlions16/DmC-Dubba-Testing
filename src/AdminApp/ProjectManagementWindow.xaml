<Window x:Class="DmC.Qa.Admin.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proje Merkezi" Height="840" Width="1120" MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}" Foreground="White">
    <Grid x:Name="ProjectRoot" Background="{StaticResource WindowBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="15" Background="#1E315FFF" BorderBrush="#527CFF" BorderThickness="1" Margin="0,0,15,0">
                    <TextBlock Text="◇" FontSize="28" Foreground="#9EB6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="PROJE MERKEZİ" Foreground="#7FA4FF" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentProjectText" Text="Aktif proje yok" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="ProjectStatusBadge" Background="#173324" BorderBrush="#2D8C62" BorderThickness="1" CornerRadius="9" Padding="9,4">
                            <TextBlock x:Name="CurrentProjectStatusText" Text="AKTİF" Foreground="#8EF0BB" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Üyeler, bölümler ve proje yaşam döngüsü tek ekrandan yönetilir." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CloseProjectButton" Content="Projeyi Kapat" Click="CloseProjectButton_Click"/>
                    <Button x:Name="PurgeProjectButton" Content="🗑 Kalıcı Olarak Sil" Style="{StaticResource DangerButton}" Click="PurgeProjectButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Mevcut Proje">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROJE ÜYELERİ" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Bu projeyi görebilecek ve görevlere atanabilecek ekip üyeleri." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="UsersList" Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" Padding="4">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Border Grid.Column="1" Background="#12213A" BorderBrush="#29466F" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                                    <TextBlock Text="{Binding Role}" Foreground="#A9B8D2" FontSize="10"/>
                                                </Border>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" x:Name="SaveMembersButton" Content="Üyelikleri Kaydet" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="SaveMembersButton_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TEST BÖLÜMLERİ" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="Mission, Chapter, Level veya proje özelindeki test bölümleri." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                </StackPanel>
                                <ListBox Grid.Row="1" x:Name="SectionsList" DisplayMemberPath="Name" Margin="0,0,0,12"/>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SectionNameInput" Height="40" Margin="0,0,8,0" ToolTip="Yeni Mission / Chapter / Bölüm adı"/>
                                    <Button Grid.Column="1" Content="+ Bölüm Ekle" Click="AddSectionButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource DangerCardStyle}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="KALICI SİLME NASIL ÇALIŞIR?" Foreground="#FF9AA6" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="Kalıcı silme HF üzerindeki proje dosyalarını ve Supabase'deki proje verilerini kaldırır. İşlem iki farklı yönetici onayı ister; başka projeler ve global kullanıcı hesapları etkilenmez."
                                           Foreground="#D2A9B0" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Yeni Proje">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Stretch">
                            <TextBlock Text="YENİ OYUN / QA PROJESİ" Foreground="#7FA4FF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Yeni bir test alanı oluştur" FontSize="24" FontWeight="Bold" Margin="0,4,0,5"/>
                            <TextBlock Text="Her proje kendi build, görev, hata, retest ve medya alanında izole tutulur." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22" TextWrapping="Wrap"/>
                            <TextBlock Text="Proje Adı" FontWeight="SemiBold"/><TextBox x:Name="NewProjectNameInput" Height="42" Margin="0,6,0,14"/>
                            <TextBlock Text="Proje Anahtarı" FontWeight="SemiBold"/><TextBlock Text="Küçük harf, sayı ve tire. Örn: dmc-turkce-dublaj" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            <TextBox x:Name="NewProjectKeyInput" Height="42" Margin="0,6,0,14"/>
                            <TextBlock Text="Bölüm Adlandırması" FontWeight="SemiBold"/>
                            <ComboBox x:Name="SectionLabelPicker" Height="42" Margin="0,6,0,20" SelectedIndex="0">
                                <ComboBoxItem Content="Mission"/><ComboBoxItem Content="Chapter"/><ComboBoxItem Content="Level"/><ComboBoxItem Content="Episode"/><ComboBoxItem Content="Bölüm"/>
                            </ComboBox>
                            <Button x:Name="CreateProjectButton" Content="Projeyi Oluştur" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="CreateProjectButton_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="PROJE İZOLASYONU" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Bir projeyi kaldırmak diğer projelere dokunmaz." TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,12"/>
                            <TextBlock Text="✓ Tester yalnız atandığı projeleri görür.\n\n✓ Build ve medya dosyaları project_id namespace'indedir.\n\n✓ Proje kapatma veri silmez.\n\n✓ Kalıcı silme HF + Supabase verisini temizler.\n\n✓ Global kullanıcı hesapları korunur."
                                       Foreground="#AAB8CF" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
