<Window x:Class="DmC.Qa.Admin.NotificationAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildirim Merkezi" Height="760" Width="980" MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="GÖNDERİLEN BİLDİRİMLER" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#111318" Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="145"/>
                        <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Tür" Binding="{Binding Severity}" Width="110"/>
                        <DataGridTextColumn Header="Okundu" Binding="{Binding Read}" Width="90"/>
                        <DataGridTextColumn Header="Onay" Binding="{Binding Ack}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="YENİ BİLDİRİM" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Başlık" Margin="0,14,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="TitleInput" Height="34"/>
                    <TextBlock Text="Mesaj" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="BodyInput" Height="130" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Önem" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="SeverityPicker" Height="34" SelectedIndex="0">
                        <ComboBoxItem Tag="info" Content="Bilgi"/>
                        <ComboBoxItem Tag="warning" Content="Uyarı"/>
                        <ComboBoxItem Tag="critical" Content="Kritik"/>
                        <ComboBoxItem Tag="must_read" Content="Okunması Zorunlu"/>
                    </ComboBox>
                    <TextBlock Text="Hedef" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="TargetPicker" Height="34" SelectedIndex="0" SelectionChanged="TargetPicker_SelectionChanged">
                        <ComboBoxItem Tag="project" Content="Bu Projedeki Herkes"/>
                        <ComboBoxItem Tag="users" Content="Seçili Kişiler"/>
                        <ComboBoxItem Tag="all" Content="Platformdaki Herkes"/>
                    </ComboBox>
                    <ListBox x:Name="MembersList" Height="170" Margin="0,10,0,0" Background="#111318" Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Foreground="White" Padding="4"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="SendButton" Content="Bildirimi Gönder" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SendButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
