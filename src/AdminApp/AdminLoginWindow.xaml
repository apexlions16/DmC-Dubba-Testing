<Window x:Class="DmC.Qa.Admin.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DmC QA • Yönetim Merkezi Girişi"
        Height="620" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="White">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border Width="455" Padding="32" CornerRadius="22" Background="#F20C1425"
                BorderBrush="#3B65B5" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#2457FF" BlurRadius="42" ShadowDepth="0" Opacity="0.31" /></Border.Effect>
            <StackPanel>
                <Border Height="150" CornerRadius="18" Background="#05070D" BorderBrush="#2A4D92" BorderThickness="1" Padding="8" Margin="0,0,0,17">
                    <Image Source="Assets/dmc-qa-logo.png" Stretch="Uniform" />
                </Border>
                <TextBlock Text="DmC QA Yönetim Merkezi" FontSize="25" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="Yönetici / Geliştirici Girişi" Foreground="{StaticResource AccentBrightBrush}"
                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,8" />
                <TextBlock Text="Build, görev, hata, retest ve ekip yönetimine güvenli cihaz oturumuyla bağlanın."
                           Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="18,0,18,25" />

                <TextBlock Text="Adınız" FontWeight="SemiBold" Margin="0,0,0,7" />
                <TextBox x:Name="DisplayNameInput" Height="44" FontSize="16" />
                <TextBlock Text="İlk kullanımda bu bilgisayar yönetici hesabınızla eşleştirilir. HF anahtarı girmeniz gerekmez."
                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <Button x:Name="LoginButton" Content="Yönetim Merkezine Gir" Height="46"
                        Style="{StaticResource AccentButton}" Margin="0,20,0,0" Click="LoginButton_Click" />
                <TextBlock Text="Cihaz kimliği ve oturum anahtarı Windows kullanıcı profilinde korunur."
                           Foreground="#66758F" FontSize="10" TextAlignment="Center" Margin="0,13,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
