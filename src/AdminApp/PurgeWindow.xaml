<Window x:Class="DmC.Qa.Admin.PurgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güvenli Kalıcı Silme" Height="790" Width="1060" MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}" Foreground="White">
    <Grid x:Name="PurgeRoot" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource DangerCardStyle}" Margin="0,0,0,16" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="15" Background="#45131D" BorderBrush="#A44557" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Text="!" FontSize="25" FontWeight="Bold" Foreground="#FF8E9B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="KALICI PROJE SİLME" Foreground="#FF8F9D" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="HF dosyaları + Supabase proje verileri tamamen kaldırılır" FontSize="22" FontWeight="Bold" Margin="0,3,0,2"/>
                    <TextBlock Text="İşlem geri alınamaz ve iki farklı yönetici onayı gerektirir. Global kullanıcı hesapları ve diğer projeler etkilenmez." Foreground="#C9A8AF" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="1. YÖNETİCİ • SİLME TALEBİ" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Text="Proje kapalı olmalıdır. Talep oluşturmak tek başına hiçbir şeyi silmez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                    <Border Grid.Row="2" Background="#091525" BorderBrush="#29486F" BorderThickness="1" CornerRadius="12" Padding="12">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#D9E3F7"/>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <TextBlock Text="Onay için proje adını birebir yazın" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ProjectNameInput" Height="40"/>
                    </StackPanel>
                    <Border Grid.Row="4" Margin="0,13,0,0" Padding="12" Background="#0A1321" BorderBrush="#2A4469" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <CheckBox x:Name="DeleteStorageCheck" Content="HF / Storage proje dosyalarını sil" IsChecked="True"/>
                            <CheckBox x:Name="DeleteDatabaseCheck" Content="Supabase proje verilerini sil" IsChecked="True"/>
                            <CheckBox x:Name="DeleteTombstoneCheck" Content="Minimal purge audit tombstone kaydını da sil" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="5" x:Name="CreateRequestButton" Content="Silme Talebini Oluştur" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CreateRequestButton_Click"/>
                    <Border Grid.Row="6" x:Name="CodePanel" Background="#32131B" BorderBrush="#A74455" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0" Visibility="Collapsed" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="İKİNCİ YÖNETİCİ DOĞRULAMA KODU" FontWeight="Bold" Foreground="#FFB0BA" FontSize="10"/>
                            <TextBlock x:Name="ConfirmationCodeText" FontSize="25" FontWeight="Bold" Foreground="#FF7485" Margin="0,6,0,2"/>
                            <TextBlock Text="Aynı yönetici ikinci onayı veremez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="2. YÖNETİCİ • SON ONAY" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Text="Aktif taleplerden birini seçin. Talebi oluşturan hesap bu onayı veremez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <DataGrid Grid.Row="2" x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="RequestsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proje" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Talep Eden" Binding="{Binding RequestedBy}" Width="125"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Background="#091525" BorderBrush="#29486F" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Proje Adı" FontWeight="SemiBold"/><TextBox x:Name="ApproveProjectNameInput" Height="40" Margin="0,6,0,10"/>
                            <TextBlock Text="Doğrulama Kodu" FontWeight="SemiBold"/><TextBox x:Name="ApproveCodeInput" Height="40" Margin="0,6,0,10"/>
                            <Button x:Name="ApproveButton" Content="İkinci Onayı Ver ve Tamamen Sil" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="ApproveButton_Click"/>
                            <TextBlock x:Name="ApprovalStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
