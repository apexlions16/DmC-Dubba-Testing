<Window x:Class="DmC.Qa.Admin.PurgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projeyi Kalıcı Olarak Sil" Height="680" Width="760" MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}" Foreground="White">
    <Grid x:Name="PurgeRoot" Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Style="{StaticResource DangerCardStyle}" Margin="0,0,0,16" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="16" Background="#45131D" BorderBrush="#A44557" BorderThickness="1" Margin="0,0,15,0">
                    <TextBlock Text="!" FontSize="27" FontWeight="Bold" Foreground="#FF8E9B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TEK YÖNETİCİ • KALICI SİLME" Foreground="#FF8F9D" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="Projeyi ve tüm proje verisini tamamen kaldır" FontSize="23" FontWeight="Bold" Margin="0,3,0,3"/>
                    <TextBlock Text="HF dosyaları, hata raporları, videolar, retestler, görevler ve proje kayıtları kaldırılır. Global kullanıcı hesapları ve diğer projeler etkilenmez."
                               Foreground="#C9A8AF" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock Text="SİLİNECEK VERİ ÖZETİ" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11"/>
                <Border Background="#091525" BorderBrush="#29486F" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,18">
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#E2E9F8" LineHeight="22"/>
                </Border>

                <TextBlock Text="Onaylamak için proje adını birebir yaz" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="ExpectedProjectNameText" Foreground="#FF9AA7" FontWeight="Bold" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <TextBox x:Name="ProjectNameInput" Height="44"/>

                <Border Margin="0,16,0,0" Padding="13" Background="#2910161F" BorderBrush="#71303E" BorderThickness="1" CornerRadius="12">
                    <TextBlock Text="Bu işlem geri alınamaz. Silme sırasında önce HF proje alanı temizlenir, ardından Supabase proje kayıtları kaldırılır. HF silme başarısız olursa veritabanı silinmez."
                               Foreground="#E4BBC2" TextWrapping="Wrap" LineHeight="20"/>
                </Border>

                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Vazgeç" HorizontalAlignment="Left" Click="CancelButton_Click"/>
            <Button x:Name="DeleteProjectButton" Grid.Column="1" Content="🗑 Projeyi Tamamen Sil"
                    Style="{StaticResource DangerButton}" MinWidth="210" Click="DeleteProjectButton_Click"/>
        </Grid>
    </Grid>
</Window>
