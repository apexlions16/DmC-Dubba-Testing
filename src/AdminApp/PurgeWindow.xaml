<Window x:Class="DmC.Qa.Admin.PurgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güvenli Kalıcı Silme" Height="760" Width="980" MinHeight="680" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="1. YÖNETİCİ • SİLME TALEBİ" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Proje önce Kapalı durumda olmalıdır. Talep oluşturmak hiçbir dosyayı tek başına silmez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap"/>
                <TextBlock Text="Devam etmek için proje adını birebir yazın:" Margin="0,16,0,4" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="ProjectNameInput" Height="34"/>
                <CheckBox x:Name="DeleteStorageCheck" Content="Storage / HF proje dosyalarını sil" IsChecked="True" Foreground="White" Margin="0,12,0,0"/>
                <CheckBox x:Name="DeleteDatabaseCheck" Content="Proje runtime verilerini sil" IsChecked="True" Foreground="White"/>
                <CheckBox x:Name="DeleteTombstoneCheck" Content="Minimal audit tombstone kaydını da sil" IsChecked="False" Foreground="White"/>
                <Button x:Name="CreateRequestButton" Content="Kalıcı Silme Talebi Oluştur" Background="#B71C1C" Foreground="White" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CreateRequestButton_Click"/>
                <Border x:Name="CodePanel" Background="#321111" BorderBrush="#C62828" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="İKİNCİ YÖNETİCİ İÇİN DOĞRULAMA KODU" FontWeight="Bold"/>
                        <TextBlock x:Name="ConfirmationCodeText" FontSize="22" FontWeight="Bold" Foreground="#FF8A80" Margin="0,6,0,0"/>
                        <TextBlock Text="Bu kodu ikinci yöneticiye güvenli biçimde verin. Aynı hesap onay veremez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16">
            <StackPanel>
                <TextBlock Text="2. YÖNETİCİ • ONAY" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Aktif silme taleplerinden birini seçin. Talebi oluşturan kişi burada ikinci onayı veremez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                <DataGrid x:Name="RequestsGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" Background="#111318" Foreground="White" SelectionChanged="RequestsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proje" Binding="{Binding ProjectName}" Width="*"/>
                        <DataGridTextColumn Header="Talep Eden" Binding="{Binding RequestedBy}" Width="120"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Proje Adı" Margin="0,14,0,4" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="ApproveProjectNameInput" Height="34"/>
                <TextBlock Text="Doğrulama Kodu" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="ApproveCodeInput" Height="34"/>
                <Button x:Name="ApproveButton" Content="İkinci Onayı Ver ve Kalıcı Silmeyi Başlat" Background="#B71C1C" Foreground="White" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ApproveButton_Click"/>
                <TextBlock x:Name="ApprovalStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
