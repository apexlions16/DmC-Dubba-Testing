<Window x:Class="DmC.Qa.Admin.ReleaseCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İstemci Sürümleri" Height="780" Width="1050" MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="YAYIN GEÇMİŞİ" FontSize="19" FontWeight="Bold"/>
                    <ComboBox x:Name="HistoryChannelPicker" Width="160" HorizontalAlignment="Left" Margin="0,10,0,12" SelectionChanged="HistoryChannelPicker_SelectionChanged">
                        <ComboBoxItem Tag="stable" Content="Kararlı" IsSelected="True"/>
                        <ComboBoxItem Tag="beta" Content="Beta"/>
                    </ComboBox>
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#111318" Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" Width="100"/>
                        <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Zorunlu" Binding="{Binding Mandatory}" Width="80"/>
                        <DataGridTextColumn Header="Yayın" Binding="{Binding Date}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="YENİ İSTEMCİ SÜRÜMÜ YAYINLA" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Kanal" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <ComboBox x:Name="ChannelPicker" Height="34" SelectedIndex="0">
                        <ComboBoxItem Tag="stable" Content="Kararlı"/>
                        <ComboBoxItem Tag="beta" Content="Beta"/>
                    </ComboBox>
                    <TextBlock Text="Sürüm" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <TextBox x:Name="VersionInput" Height="34"/>
                    <TextBlock Text="Başlık" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <TextBox x:Name="TitleInput" Height="34"/>
                    <TextBlock Text="Güncelleme Notları" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <TextBox x:Name="NotesInput" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Minimum İzin Verilen Sürüm (isteğe bağlı)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <TextBox x:Name="MinimumVersionInput" Height="34"/>
                    <CheckBox x:Name="MandatoryCheck" Content="Zorunlu güncelleme" Foreground="White" Margin="0,10,0,10"/>
                    <TextBlock Text="ZIP Payload" Foreground="{StaticResource MutedBrush}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FileInput" IsReadOnly="True" Height="34"/>
                        <Button Grid.Column="1" Content="ZIP Seç" Margin="8,0,0,0" Click="ChooseFile_Click"/>
                    </Grid>
                    <ProgressBar x:Name="UploadProgress" Height="16" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="PublishButton" Content="İstemci Sürümünü Yayınla" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Click="PublishButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
