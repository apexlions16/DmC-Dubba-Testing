<Window x:Class="DmC.Qa.Tester.RetestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeniden Testlerim"
        Height="720" Width="980"
        MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#17191D" Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#22252B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A8AFBA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#15171B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3A3E46" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101216" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YENİDEN TESTLERİM" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Düzeltildiği düşünülen sorunları belirtilen test sürümünde yeniden kontrol edin."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="PendingCountText" Text="0 bekleyen" VerticalAlignment="Center"
                           Foreground="#FFA726" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#14161A" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BEKLEYEN TALEPLER" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontWeight="Bold" Margin="5,6,5,10" />
                    <ListBox x:Name="RetestList" Background="Transparent" BorderThickness="0" Foreground="White"
                             SelectionChanged="RetestList_SelectionChanged" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock x:Name="BugKeyText" Text="—" Foreground="#EF9A9A" FontWeight="Bold" />
                    <TextBlock x:Name="BugTitleText" Text="Bir yeniden test seçin" FontSize="24" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,4,0,14" />

                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TEST EDİLECEK SÜRÜM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="BuildText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SON TARİH" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="DeadlineText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="YÖNETİCİ NOTU" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="AdminNoteText" Text="Not bulunmuyor." TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Yeniden test sonucu" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <RadioButton x:Name="PassedOption" GroupName="Result" Content="Sorun artık oluşmuyor" Margin="0,5" FontSize="14" />
                    <RadioButton x:Name="FailedOption" GroupName="Result" Content="Sorun hâlâ oluşuyor" Margin="0,5" FontSize="14" />
                    <RadioButton x:Name="UncertainOption" GroupName="Result" Content="Emin olamadım" Margin="0,5,0,14" FontSize="14" />

                    <TextBlock Text="Açıklama / Not" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="CommentInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Video / Kanıt" FontWeight="SemiBold" Margin="0,14,0,5" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="EvidenceText" Text="Video seçilmedi" TextWrapping="Wrap" />
                                <TextBlock Text="Özellikle sorun devam ediyorsa video eklemeniz önerilir."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Dosya Seç" Margin="12,0,0,0" Click="SelectEvidenceButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusText" Foreground="#FFCA28" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Kapat" Click="CloseButton_Click" />
                        <Button x:Name="SubmitButton" Content="Sonucu Gönder" Background="{StaticResource AccentBrush}"
                                Foreground="White" Click="SubmitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
