<Application x:Class="DmC.Qa.Tester.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DmC.Qa.Tester">
    <Application.Resources>
        <local:PercentageTextConverter x:Key="PercentageTextConverter" />

        <Color x:Key="WindowColor">#030611</Color>
        <Color x:Key="PanelColor">#070D19</Color>
        <Color x:Key="CardColor">#0B1425</Color>
        <Color x:Key="AccentColor">#2F63FF</Color>
        <Color x:Key="AccentBrightColor">#6B91FF</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource WindowColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A2BD" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#292F63FF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#284A7D" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#44D98A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFBD59" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6675" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#02040A" Offset="0" />
            <GradientStop Color="#07162F" Offset="0.44" />
            <GradientStop Color="#050B18" Offset="0.72" />
            <GradientStop Color="#02050C" Offset="1" />
        </LinearGradientBrush>

        <DrawingImage x:Key="BrandLogoDrawing">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2F63FF" Geometry="M 24,25 C 24,18 29,13 36,13 L 42,13 C 49,13 54,18 54,25 L 54,34 L 24,34 Z" />
                    <GeometryDrawing Brush="#2F63FF" Geometry="M 26,38 L 52,38 L 52,65 L 43,73 L 43,83 L 35,83 L 35,73 L 26,65 Z" />
                    <GeometryDrawing Brush="#050813" Geometry="M 28,18 L 50,18 M 27,23 L 51,23 M 26,28 L 52,28"><GeometryDrawing.Pen><Pen Brush="#050813" Thickness="2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Geometry="M 58,16 C 84,16 93,29 93,49 C 93,72 80,84 59,84 L 43,84 C 40,84 39,82 39,79 L 39,74"><GeometryDrawing.Pen><Pen Brush="#2F63FF" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Geometry="M 58,24 C 78,24 84,34 84,50 C 84,66 76,76 60,76"><GeometryDrawing.Pen><Pen Brush="#2F63FF" Thickness="4" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Geometry="M 22,48 L 16,42 L 18,60 L 13,65 M 56,48 L 62,42 L 60,60 L 65,65"><GeometryDrawing.Pen><Pen Brush="#2F63FF" Thickness="3" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                    <GeometryDrawing Brush="#2F63FF" Geometry="M 59,75 L 69,75 L 69,79 L 59,79 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="Icon" Value="{StaticResource BrandLogoDrawing}" /></Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FF" /><Setter Property="Background" Value="#101C32" /><Setter Property="BorderBrush" Value="#2C4B7C" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,4,8,4" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#172B4E" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#658BFF" /><Setter TargetName="Chrome" Property="Effect"><Setter.Value><DropShadowEffect Color="#315FFF" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.32" /></Trigger>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.17"/><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.17"/></Storyboard></BeginStoryboard></EventTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}" />
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Background" Value="#2F63FF" /><Setter Property="BorderBrush" Value="#779AFF" /></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Background" Value="#37151E" /><Setter Property="BorderBrush" Value="#A84458" /><Setter Property="Foreground" Value="#FFDDE2" /></Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Background" Value="#113323" /><Setter Property="BorderBrush" Value="#2D9B68" /><Setter Property="Foreground" Value="#CFFFF0" /></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,11" /><Setter Property="Margin" Value="0,3" /><Setter Property="Foreground" Value="#BAC7DC" /></Style>

        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#E00B1425" /><Setter Property="BorderBrush" Value="#2B4D7E" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="18" /><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#001735" BlurRadius="24" ShadowDepth="5" Opacity="0.32" /></Setter.Value></Setter></Style>
        <Style x:Key="DangerCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Background" Value="#E0180C15" /><Setter Property="BorderBrush" Value="#824051" /></Style>

        <Style x:Key="NeonProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="16" /><Setter Property="Background" Value="#17233A" /><Setter Property="Foreground" Value="#44D98A" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="8"/><Border x:Name="PART_Track" CornerRadius="8"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="8"><Border.Effect><DropShadowEffect Color="#44D98A" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/></Border.Effect></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1323" /><Setter Property="Foreground" Value="#F5F8FF" /><Setter Property="CaretBrush" Value="#7398FF" /><Setter Property="BorderBrush" Value="#31517F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,8" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#5275AE" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#7294FF" /><Setter TargetName="InputChrome" Property="Effect"><Setter.Value><DropShadowEffect Color="#315FFF" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputChrome" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- ComboBox stili Themes/DarkComboBox.xaml içinden gelir. -->

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAF0FF" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#0A1323" BorderBrush="#365985" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3,8 L 7,12 L 15,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#7294FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2F63FF"/><Setter TargetName="Box" Property="BorderBrush" Value="#83A2FF"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ListBox"><Setter Property="Background" Value="#07101E"/><Setter Property="Foreground" Value="#EEF3FF"/><Setter Property="BorderBrush" Value="#294A77"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EDF3FF"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="1,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#172B4E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#23427A"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>

        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#99A9C4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="#091426" BorderBrush="#253E66" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#132849"/><Setter Property="Foreground" Value="#EAF0FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#1E3C72"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="#6C90FF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#08101D"/><Setter Property="AlternatingRowBackground" Value="#0B1425"/><Setter Property="HorizontalGridLinesBrush" Value="#1B2B4D"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14294C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D3A6A"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#101A30"/><Setter Property="Foreground" Value="#A5B4CF"/><Setter Property="BorderBrush" Value="#1C2B4B"/><Setter Property="Padding" Value="10,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="#101A2C"/><Setter Property="Foreground" Value="#F5F7FF"/><Setter Property="BorderBrush" Value="#31527E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/></Style>
    </Application.Resources>
</Application>
