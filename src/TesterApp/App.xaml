<Application x:Class="DmC.Qa.Tester.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="WindowColor">#050813</Color>
        <Color x:Key="PanelColor">#0B1020</Color>
        <Color x:Key="CardColor">#0E1629</Color>
        <Color x:Key="CardHoverColor">#13213C</Color>
        <Color x:Key="AccentColor">#2457FF</Color>
        <Color x:Key="AccentBrightColor">#4777FF</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource WindowColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8794AD" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#242457FF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#263C6C" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#35D07F" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB84D" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF5E6C" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#03050B" Offset="0" />
            <GradientStop Color="#071126" Offset="0.52" />
            <GradientStop Color="#040711" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FF" />
            <Setter Property="Background" Value="#121C33" />
            <Setter Property="BorderBrush" Value="#263B66" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#17284A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4777FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}" />

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2457FF" />
            <Setter Property="BorderBrush" Value="#4777FF" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="#BAC5DA" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1120" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrightBrush}" />
            <Setter Property="BorderBrush" Value="#2A3B62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0A1120" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2A3B62" />
            <Setter Property="Padding" Value="7" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EAF0FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#081020" />
            <Setter Property="AlternatingRowBackground" Value="#0B1426" />
            <Setter Property="HorizontalGridLinesBrush" Value="#192B4E" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#101A30" />
            <Setter Property="Foreground" Value="#8FA0BF" />
            <Setter Property="BorderBrush" Value="#1B2B4B" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
