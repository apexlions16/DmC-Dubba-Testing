<Window x:Class="DmC.Qa.Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DmC Türkçe Dublaj QA"
        Width="1440" Height="900" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="White">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#EE070C17" BorderBrush="#1E3562" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                    <Border Height="132" CornerRadius="18" Background="#05070D" BorderBrush="#294D94" BorderThickness="1" Padding="8">
                        <Grid>
                            <Image Source="Assets/dmc-qa-logo.png" Stretch="Uniform" Opacity="0.96" />
                            <Border CornerRadius="18" BorderBrush="#302457FF" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#2457FF" BlurRadius="28" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="DmC Türkçe Dublaj QA" FontSize="18" FontWeight="Bold" Margin="5,13,5,0" />
                    <TextBlock Text="TEST İSTEMCİSİ" Foreground="{StaticResource AccentBrightBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="170" Margin="5,3,5,14" />

                    <Button x:Name="PanelNavButton" Style="{StaticResource NavButton}" Content="⌂   Panel" Click="PanelNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="✓   Görevim" Click="TaskNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="↻   Yeniden Test" Click="RetestNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="↓   Build Merkezi" Click="BuildNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="▤   Raporlarım" Click="ReportsNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="◉   Bildirimler" Click="NotificationsButton_Click" />

                    <TextBlock Text="PROJELERİM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="7,19,7,7" />
                    <ListBox x:Name="ProjectsList"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="16,8,16,18">
                    <Border Style="{StaticResource CardStyle}" Padding="13" Background="#B20A1426">
                        <StackPanel>
                            <TextBlock x:Name="ConnectionText" Text="● Bağlanıyor" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TesterNameText" Text="Test Ekibi Üyesi" FontWeight="Bold" Margin="0,8,0,1" />
                            <TextBlock Text="QA Ekibi" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#C4081020" BorderBrush="#1A3058" BorderThickness="0,0,0,1" Padding="26,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QA ÇALIŞMA ALANI" Foreground="#739AFF" FontSize="10" FontWeight="Bold" CharacterSpacing="120" />
                        <TextBlock x:Name="ProjectTitle" Text="Proje seçiliyor..." FontSize="25" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="11" Background="#101D36" BorderBrush="#29477F" BorderThickness="1" Padding="13,9" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" Foreground="#6F94FF" Margin="0,0,8,0" />
                                <TextBlock Text="Türkçe Dublaj QA" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ReportBugButton" Style="{StaticResource AccentButton}" Content="+ Hata Raporla" Click="ReportBugButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DashboardContent" Margin="26,22,26,34">
                    <Border x:Name="MustReadBanner" Visibility="Collapsed"
                            Background="#2A183A78" BorderBrush="#507DFF" BorderThickness="1"
                            CornerRadius="15" Padding="17" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="#402457FF">
                                <TextBlock Text="!" FontSize="23" FontWeight="Bold" Foreground="#AFC2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0" VerticalAlignment="Center">
                                <TextBlock Text="MUTLAKA OKU" FontWeight="Bold" Foreground="#BED0FF" />
                                <TextBlock x:Name="MustReadBody" TextWrapping="Wrap" Foreground="#E3E9F7" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Okudum" Click="MustReadAcknowledge_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid x:Name="SummarySection" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.72*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TaskCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AKTİF ORTAK GÖREV" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11" />
                                    <Border Grid.Column="1" Background="#291B54D9" CornerRadius="8" Padding="8,3"><TextBlock Text="PAYLAŞILAN" FontSize="9" Foreground="#C1D0FF" /></Border>
                                </Grid>
                                <TextBlock x:Name="TaskTitle" Text="Aktif ortak görev yok" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,5" TextWrapping="Wrap" />
                                <TextBlock x:Name="TaskDeadline" Text="Yeni görev atandığında burada görünecek." Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Ekip, hedef build ve son tarih aynı ortak görev altında tutulur." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,13" />
                                <Button Content="Görevi Aç" HorizontalAlignment="Left" Click="SharedTaskButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BuildCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GÜNCEL TEST BUILD'İ" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11" />
                                    <Border Grid.Column="1" Background="#172C4932" CornerRadius="8" Padding="8,3"><TextBlock Text="SHA DOĞRULAMALI" FontSize="9" Foreground="{StaticResource SuccessBrush}" /></Border>
                                </Grid>
                                <TextBlock x:Name="BuildVersion" Text="—" FontSize="30" FontWeight="Bold" Foreground="#F6F8FF" Margin="0,10,0,0" />
                                <TextBlock x:Name="BuildTitle" Text="Yayınlanmış test sürümü yok" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="BuildPublished" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" />
                                <WrapPanel>
                                    <Button x:Name="BuildDownloadButton" Style="{StaticResource AccentButton}" Content="Build'i İndir" Click="BuildDownloadButton_Click" />
                                    <Button Content="Kurulum Talimatı" Click="InstallInstructionsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RetestCard" Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="YENİDEN TEST" Foreground="#B493FF" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="RetestCount" Text="0" FontSize="40" FontWeight="Bold" Margin="0,11,0,0" />
                                <TextBlock Text="sonuç bekliyor" Foreground="{StaticResource MutedBrush}" />
                                <Button x:Name="RetestButton" Content="Yeniden Testleri Aç" HorizontalAlignment="Left" Margin="0,17,0,0" Click="RetestButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ProgressSection" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BİLİNEN SORUNLARIN DURUMU" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="Bu gösterge test kapsamı değildir; yalnızca bilinen ve geçerli sorunların çözüm yaşam döngüsüdür." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ResolutionPercent" Text="—" FontSize="21" FontWeight="Bold" Foreground="#91ACFF" />
                            </Grid>
                            <Grid Grid.Row="1" Height="16" Margin="0,19,0,12" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TesterResolvedColumn" Width="1*" />
                                    <ColumnDefinition x:Name="TesterInProgressColumn" Width="1*" />
                                    <ColumnDefinition x:Name="TesterRetestColumn" Width="1*" />
                                    <ColumnDefinition x:Name="TesterNewColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#35D07F" CornerRadius="8,0,0,8" />
                                <Border Grid.Column="1" Background="#4777FF" />
                                <Border Grid.Column="2" Background="#B06EFF" />
                                <Border Grid.Column="3" Background="#34415A" CornerRadius="0,8,8,0" />
                            </Grid>
                            <WrapPanel Grid.Row="2">
                                <TextBlock Text="● Çözüldü" Foreground="#35D07F" Margin="0,0,22,0" />
                                <TextBlock Text="● Ele Alınıyor" Foreground="#4777FF" Margin="0,0,22,0" />
                                <TextBlock Text="● Yeniden Test" Foreground="#B06EFF" Margin="0,0,22,0" />
                                <TextBlock Text="● Başlanmadı" Foreground="#7A879D" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ReportsSection" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="19,17,19,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SON RAPORLARIM" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="Gönderdiğin raporların güncel yönetim durumu" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Yeni Hata Raporu" Style="{StaticResource AccentButton}" Click="ReportBugButton_Click" />
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="MyReportsGrid" Height="260" Margin="1,0,1,1"
                                      AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="145" />
                                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Hata Türü" Binding="{Binding BugType}" Width="180" />
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="175" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.ColumnSpan="2" x:Name="EnrollmentOverlay" Background="#F2050810" Visibility="Visible">
            <Border Width="490" Padding="32" CornerRadius="22" Background="#F30C1425" BorderBrush="#3B65B5" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#2457FF" BlurRadius="42" ShadowDepth="0" Opacity="0.32" /></Border.Effect>
                <StackPanel>
                    <Image Source="Assets/dmc-qa-logo.png" Height="136" Stretch="Uniform" Margin="0,-10,0,8" />
                    <TextBlock Text="DmC Türkçe Dublaj QA" FontSize="25" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="Test ekibine bağlanmak için yalnızca ekipte kullandığın adını yaz." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="24,8,24,25" />
                    <TextBlock Text="Adın" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="DisplayNameInput" Height="44" FontSize="16" />
                    <TextBlock x:Name="EnrollmentError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <Button x:Name="EnrollButton" Content="Devam Et" Style="{StaticResource AccentButton}" Height="46" Margin="0,18,0,0" Click="EnrollButton_Click" />
                    <TextBlock Text="HF anahtarı, terminal veya teknik ayar girmen gerekmez." Foreground="#697791" FontSize="10" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
