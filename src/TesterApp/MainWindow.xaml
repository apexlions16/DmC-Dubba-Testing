<Window x:Class="DmC.Qa.Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DmC Türkçe Dublaj QA"
        Height="860" Width="1380" MinHeight="760" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="White">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol marka ve navigasyon alanı -->
        <Border Grid.Column="0" Background="#E9070B16" BorderBrush="#172C54" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                    <Border Height="126" CornerRadius="16" Background="#05070D" BorderBrush="#223E7A" BorderThickness="1" Padding="8">
                        <Image Source="Assets/dmc-qa-logo.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="DmC Türkçe Dublaj QA" FontSize="17" FontWeight="Bold" Margin="4,12,4,0" />
                    <TextBlock Text="TEST İSTEMCİSİ" Foreground="{StaticResource AccentBrightBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="180" Margin="4,2,4,14" />

                    <Button x:Name="PanelNavButton" Style="{StaticResource NavButton}" Content="⌂   Panel" Click="PanelNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="✓   Görevim" Click="TaskNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="↻   Yeniden Test" Click="RetestNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="↓   Build Merkezi" Click="BuildNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="▤   Raporlarım" Click="ReportsNavButton_Click" />
                    <Button Style="{StaticResource NavButton}" Content="◉   Bildirimler" Click="NotificationsButton_Click" />

                    <TextBlock Text="PROJELERİM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="6,20,6,8" />
                    <ListBox x:Name="ProjectsList"
                             MaxHeight="190"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="16,10,16,18">
                    <Border Style="{StaticResource CardStyle}" Padding="12" Background="#0A1426">
                        <StackPanel>
                            <TextBlock x:Name="ConnectionText" Text="● Bağlanıyor" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TesterNameText" Text="Test Ekibi Üyesi" FontWeight="Bold" Margin="0,8,0,1" />
                            <TextBlock Text="QA Ekibi" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ana çalışma alanı -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#B80A1020" BorderBrush="#172A50" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hoş geldin" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock x:Name="ProjectTitle" Text="Proje seçiliyor..." FontSize="23" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="#111D35" BorderBrush="#28457C" BorderThickness="1" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Türkçe Dublaj QA" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource AccentButton}" Content="+ Hata Raporla" Click="ReportBugButton_Click" x:Name="ReportBugButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DashboardContent" Margin="24,22,24,30">
                    <Border x:Name="MustReadBanner"
                            Background="#241F3A6E" BorderBrush="#4777FF" BorderThickness="1"
                            CornerRadius="14" Padding="16" Margin="0,0,0,18" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="#2B2457FF" VerticalAlignment="Center">
                                <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="#80A0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="MUTLAKA OKU" FontWeight="Bold" Foreground="#AFC2FF" />
                                <TextBlock x:Name="MustReadBody" TextWrapping="Wrap" Foreground="#DDE5F7" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Okudum" Click="MustReadAcknowledge_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid x:Name="SummarySection" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.72*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TaskCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AKTİF ORTAK GÖREV" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11" />
                                    <Border Grid.Column="1" Background="#241B54D9" CornerRadius="8" Padding="8,3"><TextBlock Text="PAYLAŞILAN" FontSize="9" Foreground="#B6C8FF" /></Border>
                                </Grid>
                                <TextBlock x:Name="TaskTitle" Text="Aktif ortak görev yok" FontSize="19" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap" />
                                <TextBlock x:Name="TaskDeadline" Text="Yeni görev atandığında burada görünecek." Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Görev detayları, ekip ve deadline bilgisi ortak panelde görünür." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,12" />
                                <Button Content="Görevi Aç" HorizontalAlignment="Left" Click="SharedTaskButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BuildCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GÜNCEL TEST BUILD'İ" Foreground="#7FA4FF" FontWeight="Bold" FontSize="11" />
                                    <Border Grid.Column="1" Background="#172C4932" CornerRadius="8" Padding="8,3"><TextBlock Text="SHA DOĞRULAMALI" FontSize="9" Foreground="{StaticResource SuccessBrush}" /></Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock x:Name="BuildVersion" Text="—" FontSize="28" FontWeight="Bold" Foreground="#F5F8FF" />
                                </StackPanel>
                                <TextBlock x:Name="BuildTitle" Text="Yayınlanmış test sürümü yok" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="BuildPublished" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,11" />
                                <WrapPanel>
                                    <Button x:Name="BuildDownloadButton" Style="{StaticResource AccentButton}" Content="Build'i İndir" Click="BuildDownloadButton_Click" />
                                    <Button Content="Kurulum Talimatı" Click="InstallInstructionsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RetestCard" Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="YENİDEN TEST" Foreground="#B493FF" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="RetestCount" Text="0" FontSize="38" FontWeight="Bold" Margin="0,10,0,0" />
                                <TextBlock Text="sonuç bekliyor" Foreground="{StaticResource MutedBrush}" />
                                <Button x:Name="RetestButton" Content="Yeniden Testleri Aç" HorizontalAlignment="Left" Margin="0,16,0,0" Click="RetestButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ProgressSection" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BİLİNEN SORUNLARIN DURUMU" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="Bu gösterge test kapsamı değildir; yalnızca bilinen ve geçerli sorunların çözüm yaşam döngüsünü gösterir." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ResolutionPercent" Text="—" FontSize="20" FontWeight="Bold" Foreground="#8DAAFF" />
                            </Grid>
                            <Grid Grid.Row="1" Height="16" Margin="0,18,0,12" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="13*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#35D07F" CornerRadius="8,0,0,8" />
                                <Border Grid.Column="1" Background="#4777FF" />
                                <Border Grid.Column="2" Background="#B06EFF" />
                                <Border Grid.Column="3" Background="#34415A" CornerRadius="0,8,8,0" />
                            </Grid>
                            <WrapPanel Grid.Row="2">
                                <TextBlock Text="● Çözüldü" Foreground="#35D07F" Margin="0,0,22,0" />
                                <TextBlock Text="● Ele Alınıyor" Foreground="#4777FF" Margin="0,0,22,0" />
                                <TextBlock Text="● Yeniden Test" Foreground="#B06EFF" Margin="0,0,22,0" />
                                <TextBlock Text="● Başlanmadı" Foreground="#7A879D" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ReportsSection" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="18,16,18,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SON RAPORLARIM" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="Gönderdiğin hata raporlarının güncel yönetim durumları" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Yeni Hata Raporu" Style="{StaticResource AccentButton}" Click="ReportBugButton_Click" />
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="MyReportsGrid" Height="245" Margin="1,0,1,1"
                                      AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="140" />
                                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Hata Türü" Binding="{Binding BugType}" Width="175" />
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- İlk kullanım -->
        <Grid Grid.ColumnSpan="2" x:Name="EnrollmentOverlay" Background="#F2050810" Visibility="Visible">
            <Border Width="480" Padding="30" CornerRadius="20" Background="#F30C1425" BorderBrush="#355CA8" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#2457FF" BlurRadius="35" ShadowDepth="0" Opacity="0.28" />
                </Border.Effect>
                <StackPanel>
                    <Image Source="Assets/dmc-qa-logo.png" Height="128" Stretch="Uniform" Margin="0,-8,0,8" />
                    <TextBlock Text="DmC Türkçe Dublaj QA" FontSize="24" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="Test ekibine bağlanmak için yalnızca ekipte kullandığın adını yaz." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="22,8,22,24" />
                    <TextBlock Text="Adın" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="DisplayNameInput" Height="42" FontSize="16" />
                    <TextBlock x:Name="EnrollmentError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <Button x:Name="EnrollButton" Content="Devam Et" Style="{StaticResource AccentButton}" Height="44" Margin="0,18,0,0" Click="EnrollButton_Click" />
                    <TextBlock Text="HF anahtarı veya teknik ayar girmen gerekmez." Foreground="#65738B" FontSize="10" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
