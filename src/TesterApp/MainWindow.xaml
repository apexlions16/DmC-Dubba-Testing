<Window x:Class="DmC.Qa.Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oyun QA Test Uygulaması" Height="780" Width="1220"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101216" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OYUN QA" FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="Test İstemcisi" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionText" Text="● Bağlanıyor" Foreground="#F9A825" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TesterNameText" Text="Test Ekibi Üyesi" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="DashboardRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#14161A" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="PROJELERİM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,8,4,10" />
                        <ListBox x:Name="ProjectsList" Background="Transparent" BorderThickness="0" Foreground="White">
                            <ListBoxItem Padding="10" IsSelected="True">
                                <StackPanel>
                                    <TextBlock Text="DmC: Devil May Cry" FontWeight="SemiBold" />
                                    <TextBlock Text="2 görev • 1 yeniden test" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Separator Margin="0,12" Background="#333740" />
                        <Button Content="Bildirimler" HorizontalContentAlignment="Left" />
                        <Button Content="Güncelleme Notları" HorizontalContentAlignment="Left" />
                        <Button Content="Ayarlar" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26">
                    <Border x:Name="MustReadBanner" Background="#6A1B1A" CornerRadius="8" Padding="16" Margin="0,0,0,18" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚠ OKUNMASI ZORUNLU DUYURU" FontWeight="Bold" />
                            <TextBlock x:Name="MustReadBody" TextWrapping="Wrap" Margin="0,8,0,10" />
                            <Button Content="Okudum" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ProjectTitle" Text="DmC: Devil May Cry" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Türkçe Dublaj Kalite Testi" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,3,0,20" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="AKTİF ORTAK GÖREV" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="TaskTitle" Text="Mission 04 — Tam Bölüm Testi" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBlock x:Name="TaskDeadline" Text="24 gün kaldı" Foreground="#FFCA28" />
                                <TextBlock Text="Ahmet • Mehmet • Burak" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" />
                                <Button Content="Görevi Aç" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="GÜNCEL TEST SÜRÜMÜ" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="BuildVersion" Text="0.6.4" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock x:Name="BuildTitle" Text="Mission 04 Ses Düzeltme Sürümü" TextWrapping="Wrap" />
                                <TextBlock x:Name="BuildPublished" Text="Yayın: 10 Ağustos 2026" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10" />
                                <WrapPanel>
                                    <Button Content="Test Sürümünü İndir" />
                                    <Button Content="Kurulum Talimatları" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="YENİDEN TEST" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="RetestCount" Text="2" FontSize="32" FontWeight="Bold" Margin="0,4,0,0" />
                                <TextBlock Text="senden sonuç bekliyor" Foreground="{StaticResource MutedBrush}" />
                                <Button Content="Yeniden Testleri Gör" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BİLİNEN SORUNLARIN DURUMU" FontWeight="Bold" />
                                    <TextBlock Text="Bu oran testin tamamlanma yüzdesi değildir." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ResolutionPercent" Text="%61,8 çözüldü" FontSize="17" FontWeight="Bold" />
                            </Grid>

                            <Grid Grid.Row="1" Height="14" Margin="0,16,0,12" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="13*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#43A047" CornerRadius="7,0,0,7" />
                                <Border Grid.Column="1" Background="#1E88E5" />
                                <Border Grid.Column="2" Background="#FB8C00" />
                                <Border Grid.Column="3" Background="#616161" CornerRadius="0,7,7,0" />
                            </Grid>

                            <WrapPanel Grid.Row="2">
                                <TextBlock Text="● 84 Çözüldü" Foreground="#66BB6A" Margin="0,0,22,0" />
                                <TextBlock Text="● 21 Üzerinde Çalışılıyor" Foreground="#42A5F5" Margin="0,0,22,0" />
                                <TextBlock Text="● 13 Yeniden Test" Foreground="#FFA726" Margin="0,0,22,0" />
                                <TextBlock Text="● 18 Yeni" Foreground="#BDBDBD" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Son Raporlarım" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ Hata Raporla" Background="{StaticResource AccentBrush}" Foreground="White" />
                    </Grid>

                    <DataGrid x:Name="MyReportsGrid" Margin="0,10,0,20" Height="230"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource CardBrush}" Foreground="White"
                              BorderBrush="#30343B" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="140" />
                            <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Hata Türü" Binding="{Binding BugType}" Width="160" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.RowSpan="2" x:Name="EnrollmentOverlay" Background="#EE101216" Visibility="Visible">
            <Border Width="430" Padding="30" CornerRadius="14" Background="{StaticResource CardBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="DmC Türkçe Dublaj Test" FontSize="24" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="İlk kullanım için yalnızca adınızı yazın." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,8,0,24" />
                    <TextBlock Text="Adınız" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="DisplayNameInput" Height="38" FontSize="16" Padding="8" />
                    <TextBlock x:Name="EnrollmentError" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button x:Name="EnrollButton" Content="Devam" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,18,0,0" Click="EnrollButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
