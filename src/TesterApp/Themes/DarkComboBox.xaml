<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ComboDropToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="#EEF3FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#183568" /><Setter Property="Foreground" Value="White" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#2F63FF" /><Setter Property="Foreground" Value="White" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="#F2F6FF" />
        <Setter Property="Background" Value="#091423" />
        <Setter Property="BorderBrush" Value="#31547F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0,40,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
                        <Border x:Name="FocusGlow" BorderBrush="#6F93FF" BorderThickness="1" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect><DropShadowEffect Color="#315FFF" BlurRadius="12" ShadowDepth="0" Opacity="0.34" /></Border.Effect>
                        </Border>

                        <ToggleButton x:Name="DropDownToggle" Style="{StaticResource ComboDropToggleStyle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="SelectionPresenter" Margin="12,0,40,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                <Border Width="38" HorizontalAlignment="Right" Background="#0D1A2E" BorderBrush="#2B4B77" BorderThickness="1,0,0,0" CornerRadius="0,10,10,0">
                                    <Path Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#A6BCFF" Data="M 0 0 L 5 5.5 L 10 0 Z" />
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Margin="12,2,41,2" Padding="0"
                                 Background="Transparent" BorderThickness="0" Foreground="#F2F6FF" CaretBrush="#82A2FF"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,5,0,0" Padding="5" Background="#081322" BorderBrush="#365D91" BorderThickness="1" CornerRadius="12">
                                <Border.Effect><DropShadowEffect Color="#001632" BlurRadius="24" ShadowDepth="8" Opacity="0.65" /></Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#0C1A2D" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#5278B3" /><Setter TargetName="FocusGlow" Property="Opacity" Value="0.35" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7898FF" /><Setter TargetName="FocusGlow" Property="Opacity" Value="0.75" /></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#0E1E34" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#7898FF" /><Setter TargetName="FocusGlow" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /><Setter Property="Foreground" Value="#73829B" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
