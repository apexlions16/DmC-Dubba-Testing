<Window x:Class="DmC.Qa.Tester.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildirimler" Height="640" Width="820" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Foreground="White">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="NotificationList" Background="{StaticResource CardBrush}" Foreground="White" SelectionChanged="NotificationList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="18" Margin="10,0,0,0">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MetaText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"/>
                <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="14"/></ScrollViewer>
                <Button x:Name="AcknowledgeButton" Content="Okudum ve Anladım" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Click="AcknowledgeButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
